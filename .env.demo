APP_NAME=APEX Algo AI
APP_ENV=development
CORS_ORIGINS_RAW=http://localhost:5173
TIMEZONE=Asia/Kolkata

DATABASE_URL=postgresql+psycopg://apex:apex@db:5432/apex

TRADING_MODE=PAPER
AUTO_TRADING_ENABLED=true
AUTO_SCAN_INTERVAL_SECONDS=30
TRADE_START_TIME=09:20
STOP_NEW_TRADE_TIME=15:00
FORCE_EXIT_TIME=15:10
CANDLE_INTERVAL_MINUTES=5

CAPITAL=20000
MIN_TRADING_CAPITAL=5000
CAPITAL_USAGE_PCT=85
AUTO_COMPOUND_PROFITS=true
MAX_DEPLOYABLE_CAPITAL=0
DYNAMIC_RISK_LIMITS=true
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=2.0
MAX_WEEKLY_LOSS_PCT=4.0
MAX_MONTHLY_DRAWDOWN_PCT=10.0
MONTHLY_PROFIT_TARGET_PCT=20.0
MONTHLY_TARGET_LOCK=true
MAX_TRADES_PER_DAY=2
MAX_CONCURRENT_POSITIONS=1
ALLOW_LIVE_ORDERS=false

SIGNAL_MIN_SCORE=0.65
REWARD_RISK_RATIO=1.8
OPTION_STOP_PCT=18
CANDLE_CONFIRMATION_REQUIRED=true

ADAPTIVE_LEARNING_ENABLED=true
EXPLORATION_RATE=0.10
LEARNING_RATE=0.08
MINIMUM_LEARNING_TRADES=20
RESEARCH_PRIOR_WEIGHT=0.20
ALLOW_SCALP_STRATEGY=true
MIN_CAPITAL_FOR_SCALP=30000

DAILY_RESEARCH_ENABLED=true
DAILY_RESEARCH_TIME=15:45
BACKTEST_LOOKBACK_DAYS=30
BACKTEST_MAX_HOLD_BARS=6
BACKTEST_ATR_STOP_MULT=1.0

FORCE_EXIT_RETRY_COUNT=3
FORCE_EXIT_RETRY_DELAY_SECONDS=1

MARKET_DATA_PROVIDER=yfinance
PAPER_BROKER=internal
YFINANCE_NIFTY_SYMBOL=^NSEI
YFINANCE_BANKNIFTY_SYMBOL=^NSEBANK
YFINANCE_SENSEX_SYMBOL=^BSESN
YFINANCE_INTRADAY_PERIOD=5d
YFINANCE_MAX_DELAY_MINUTES=30
YFINANCE_SYNTHETIC_PREMIUM_PCT=0.50
YFINANCE_SYNTHETIC_DELTA=0.45
YFINANCE_SYNTHETIC_LOT_SIZE=1

UPSTOX_ACCESS_TOKEN=
UPSTOX_SANDBOX_TOKEN=
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

VITE_API_URL=http://localhost:8000
