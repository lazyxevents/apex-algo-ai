APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FOREX_DATABASE_URL=sqlite:///./indian_forex.db
# Existing APEX backend MongoDB credentials are reused automatically:
# MONGODB_URI=
# MONGODB_DATABASE=apgoai

# OANDA v20 practice account only. Create a demo account and API token first.
OANDA_ACCESS_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
OANDA_TIMEOUT_SECONDS=15
OANDA_DEFAULT_INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD,USD_CHF,NZD_USD

# Random long secret shared with the MT5 Expert Advisor. Never commit the real value.
MT5_BRIDGE_TOKEN=replace-with-a-long-random-secret

MARKET_STALE_AFTER_SECONDS=10
PAPER_STARTING_BALANCE=100000
PAPER_MAX_RISK_PER_TRADE=500
PAPER_MAX_DAILY_LOSS=1500
PAPER_MAX_OPEN_POSITIONS=1
PAPER_DEFAULT_SLIPPAGE_TICKS=1
PAPER_FEE_PER_ORDER=0
