# ---------- App ----------
APP_NAME=APEX Algo AI
APP_ENV=development
CORS_ORIGINS_RAW=http://localhost:5173
TIMEZONE=Asia/Kolkata

# ---------- Database ----------
DATABASE_URL=postgresql+psycopg://apex:apex@db:5432/apex
# DATABASE_URL=sqlite:///./apex.db

# ---------- Automation ----------
TRADING_MODE=OFF
AUTO_TRADING_ENABLED=true
AUTO_SCAN_INTERVAL_SECONDS=30
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
TRADE_START_TIME=09:20
STOP_NEW_TRADE_TIME=15:15
FORCE_EXIT_TIME=15:20
CANDLE_INTERVAL_MINUTES=1

# ---------- Capital / compounding / risk ----------
CAPITAL=40000
MIN_TRADING_CAPITAL=5000
CAPITAL_USAGE_PCT=80
AUTO_COMPOUND_PROFITS=true
MAX_DEPLOYABLE_CAPITAL=0
DYNAMIC_RISK_LIMITS=true
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=2.0
MAX_WEEKLY_LOSS_PCT=4.0
MAX_MONTHLY_DRAWDOWN_PCT=10.0
MONTHLY_PROFIT_TARGET_PCT=20.0
MONTHLY_TARGET_LOCK=true

# Used only when DYNAMIC_RISK_LIMITS=false
MAX_RISK_PER_TRADE=200
MAX_DAILY_LOSS=400
MAX_WEEKLY_LOSS=800
MAX_MONTHLY_DRAWDOWN=2000
MAX_TRADES_PER_DAY=5
MAX_CONCURRENT_POSITIONS=1
ALLOW_LIVE_ORDERS=false

# ---------- Strategy / option selection ----------
SIGNAL_MIN_SCORE=0.65
SMC_OVERRIDE_MIN_SCORE=0.55
REWARD_RISK_RATIO=1.8
OPTION_STOP_PCT=18
MAX_OPTION_SPREAD_PCT=2.5
MIN_OPTION_VOLUME=1000
TARGET_DELTA=0.42
MAX_OTM_STEPS=3
CANDLE_CONFIRMATION_REQUIRED=true

# ---------- Adaptive/contextual learning ----------
ADAPTIVE_LEARNING_ENABLED=true
EXPLORATION_RATE=0.10
LEARNING_RATE=0.08
MINIMUM_LEARNING_TRADES=20
RESEARCH_PRIOR_WEIGHT=0.20
ALLOW_SCALP_STRATEGY=true
MIN_CAPITAL_FOR_SCALP=30000

# ---------- Daily research / backtest ----------
DAILY_RESEARCH_ENABLED=true
DAILY_RESEARCH_TIME=15:20
BACKTEST_LOOKBACK_DAYS=30
BACKTEST_MAX_HOLD_BARS=6
BACKTEST_ATR_STOP_MULT=1.0

# ---------- Exit resilience ----------
FORCE_EXIT_RETRY_COUNT=3
FORCE_EXIT_RETRY_DELAY_SECONDS=1

# ---------- Market data provider ----------
# yfinance/yahoo = no account, no PAN/KYC, no token.
# upstox/dhan = real broker market-data adapters.
MARKET_DATA_PROVIDER=yfinance
PAPER_BROKER=internal
# Future execution broker. PAPER mode never sends exchange orders.
EXECUTION_BROKER=dhan

# ---------- Token-free Yahoo/yfinance demo ----------
YFINANCE_NIFTY_SYMBOL=^NSEI
YFINANCE_BANKNIFTY_SYMBOL=^NSEBANK
YFINANCE_SENSEX_SYMBOL=^BSESN
YFINANCE_INTRADAY_PERIOD=5d
YFINANCE_MAX_DELAY_MINUTES=30
# Strict execution guard; research may tolerate older Yahoo data, new entries may not.
LIVE_TRADE_CANDLE_MAX_AGE_SECONDS=180

# Synthetic paper-option model. This is NOT an NSE option-chain feed.
YFINANCE_SYNTHETIC_PREMIUM_PCT=0.50
YFINANCE_SYNTHETIC_DELTA=0.45
YFINANCE_SYNTHETIC_LOT_SIZE=1

# ---------- Upstox (leave blank in Yahoo demo mode) ----------
UPSTOX_ACCESS_TOKEN=
UPSTOX_SANDBOX_TOKEN=
UPSTOX_SANDBOX_PRODUCT=I
UPSTOX_NIFTY_KEY=NSE_INDEX|Nifty 50
UPSTOX_BANKNIFTY_KEY=NSE_INDEX|Nifty Bank
UPSTOX_SENSEX_KEY=BSE_INDEX|SENSEX

# ---------- DhanHQ (recommended for fresh data + internal PAPER) ----------
# Never commit real values. Add DHAN_CLIENT_ID and DHAN_ACCESS_TOKEN as Railway secrets.
# Dhan access tokens are short-lived; refresh them through the official Dhan flow.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_NIFTY_KEY=IDX_I|13|INDEX
DHAN_BANKNIFTY_KEY=IDX_I|25|INDEX
DHAN_SENSEX_KEY=IDX_I|51|INDEX
DHAN_INTRADAY_LOOKBACK_DAYS=5
DHAN_PRODUCT_TYPE=INTRADAY

# ---------- Zerodha reserved for later ----------
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# ---------- LLM fallback ----------
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free



# ---------- Frontend ----------
VITE_API_URL=http://localhost:8000

# ---------- Continuous research / learning worker ----------
# Research-only: never bypasses hard risk controls or directly places orders.
LEARNING_WORKER_ENABLED=true
LEARNING_WORKER_INTERVAL_MINUTES=60
LEARNING_WORKER_DAILY_HOURS=15
LEARNING_WORKER_MAX_SOURCES=120
RESEARCH_WEB_ENABLED=true
RESEARCH_MAX_ARTICLES_PER_CYCLE=16
RESEARCH_SOURCE_TIMEOUT_SECONDS=8

# ---------- Automatic neural training (paper/shadow only) ----------
NEURAL_TRAINING_ENABLED=true
NEURAL_MIN_LABELED_SAMPLES=500
NEURAL_HIDDEN_UNITS=24
NEURAL_EPOCHS=45
NEURAL_BATCH_SIZE=256
NEURAL_LEARNING_RATE=0.015
NEURAL_L2=0.0005
NEURAL_PROMOTION_MIN_AUC=0.54
NEURAL_PROMOTION_MAX_BRIER=0.25
NEURAL_INFERENCE_WEIGHT=0.15

# SENSEX-first paper/shadow profile
ACTIVE_INDICES_RAW=SENSEX
SENSEX_LOT_SIZE=20
SCALP_TARGET_POINTS=4
SCALP_ENTRY_PULLBACK_POINTS=10
SCALP_MAX_STOP_POINTS=40
SWING_FIRST_TARGET_POINTS=55
SWING_RUNNER_TARGET_POINTS=150
SWING_PARTIAL_PCT=50


# ---------- Browser trade alerts ----------
PUSH_NOTIFICATIONS_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:officialtarun070@gmail.com


# Manual Do Trade (PAPER only)
MANUAL_DO_TRADE_ENABLED=true
MANUAL_DO_TRADE_CUTOFF_TIME=15:20
MANUAL_DO_TRADE_TARGET_POINTS=30
MANUAL_DO_TRADE_STOP_POINTS=15
MANUAL_DO_TRADE_CAPITAL_USAGE_PCT=100
MANUAL_DO_TRADE_MIN_MTF_SCORE=0.50
MANUAL_DO_TRADE_CARRY_FORWARD=true


# ---------- APEX 15h learning window ----------
LEARNING_WORKER_WINDOW_START_TIME=17:00
LEARNING_WORKER_WINDOW_END_TIME=08:00
PREMARKET_PLAN_TIME=08:00
